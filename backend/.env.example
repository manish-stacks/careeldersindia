NODE_ENV=development
PORT=5000
API_PUBLIC_URL=http://localhost:5000
CLIENT_APP_URL=http://localhost:8081
ADMIN_APP_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/parentcare?directConnection=true
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=78eed4515b767ee97cefc739449469d577b0d11b81afd8402e630ceb543600a7a2169f50d401fdf715a69390a34991d5
JWT_REFRESH_SECRET=4e5ec068d753c95e879173c1d7752afb5e0b255fff7c8a24188581a09f032f756ae81c80c8217eb0794a5388955815ba
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

ENCRYPTION_KEY=cfc3573771e6192144b14a0a6d0bc7382bfa681d7327717a6738aa668aec14ae
MEDIA_SIGNING_SECRET=a00a9835855ad64904648e7b6901ee4b20136d13ca781664a649bc79d300d2c1

# Admin web uses httpOnly refresh cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

FIREBASE_PROJECT_ID=
# E-mail (any SMTP; Gmail needs an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ParentCare <no-reply@example.com>
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# STORAGE_DRIVER=local | s3  (s3 works with AWS S3, Cloudflare R2, DO Spaces, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Run BullMQ workers inside API process (false => run `npm run worker` separately)
RUN_WORKERS=true
RECURRING_HORIZON_DAYS=14
LOCATION_HISTORY_TTL_DAYS=30

# Deep links / universal links — host the app links point at (serve /.well-known from this API or copy the JSON to your website)
APP_LINK_HOST=parentcare.in
APPLE_TEAM_ID=
IOS_BUNDLE_ID=in.parentcare.app
ANDROID_PACKAGE=in.parentcare.app
# comma-separated SHA-256 signing cert fingerprints (Play App Signing + upload key)
ANDROID_SHA256_CERT_FINGERPRINTS=
# background location: how long a trip token stays valid
TRIP_TOKEN_TTL_HOURS=12

# Accounts are created by the admin. Set true only if you want public signup.
ALLOW_SELF_REGISTRATION=false
