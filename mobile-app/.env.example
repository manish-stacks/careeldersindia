# Your computer's LAN IP — a phone cannot reach "localhost".
# Also set API_PUBLIC_URL in backend/.env to the same host so photo/PDF links open on the phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
# Universal links host (https://<host>/app/...). Also set APP_LINK_HOST etc. in backend/.env
EXPO_PUBLIC_APP_LINK_HOST=parentcare.in
